# Irori server configuration
# PostgreSQL on the Proxmox pgsql server (ADR-0002)
DATABASE_URL=postgres://iroiri:change-me@10.0.10.5:5432/iroiri

# 32-byte hex key for AES-256-GCM secret encryption (ADR-0002) — generate: openssl rand -hex 32
ENCRYPTION_KEY=

# HTTP port for the server (default 3947)
PORT=3947

# Agent configuration (set on the NODE, not the server)
# IRORI_SERVER_URL=ws://10.0.10.9:3947/agent-ws
# IRORI_NODE_TOKEN=<per-node token from the server UI>
# IRORI_CADENCE_MS=2000
