{
  "name": "@irori/server",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "node --env-file=../../.env --watch dist/index.js",
    "test:coverage": "vitest run --coverage --coverage.thresholds.lines=75"
  },
  "dependencies": {
    "@irori/core": "workspace:*",
    "@irori/db": "workspace:*",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/api-logs": "^0.223.0",
    "@opentelemetry/core": "^3.0.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.300.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-logs": "^3.0.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "drizzle-orm": "^0.45.2",
    "express": "^5.1.0",
    "pino": "^10.4.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@irori/proxy": "workspace:*",
    "@types/express": "^5.0.3",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.18.1",
    "supertest": "^7.1.4",
    "typescript": "^5.9.2",
    "vitest": "^4.1.12"
  }
}
