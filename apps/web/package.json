{
  "name": "@irori/web",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vue-tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "vite",
    "test:coverage": "vitest run --coverage --coverage.thresholds.lines=57"
  },
  "dependencies": {
    "@irori/core": "workspace:*",
    "vue": "^3.5.21"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.1.0"
  }
}
