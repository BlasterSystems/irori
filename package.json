{
  "name": "irori",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BlasterSystems/irori.git"
  },
  "version": "0.7.0",
  "description": "Irori — AI fleet platform for DGX Spark homelabs",
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "esbuild@<0.25.12": ">=0.25.12",
      "body-parser@<2.4.0": ">=2.4.0",
      "glob@>=9.0.0 <=14.0.1": ">=14.0.2",
      "minimatch@<11.0.1": ">=11.0.1"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r build && pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "dev": "pnpm --filter @irori/web dev & pnpm --filter @irori/server dev",
    "coverage": "pnpm -r test:coverage"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^21.0.4",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  }
}
