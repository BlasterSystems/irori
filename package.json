{
  "name": "irori",
  "private": true,
  "version": "0.3.0",
  "description": "Irori \u2014 AI fleet platform for DGX Spark homelabs",
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "esbuild@<0.25.12": ">=0.25.12"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r build && pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "dev": "pnpm --filter @irori/web dev & pnpm --filter @irori/server dev"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  }
}
